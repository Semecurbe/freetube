#:import rgb kivy.utils.get_color_from_hex
#:set BG rgb("#0f0f0f")
#:set SURFACE rgb("#272727")
#:set TEXT rgb("#f1f1f1")
#:set MUTED rgb("#aaaaaa")
#:set ACCENT rgb("#f04438")

<WrappedLabel@Label>:
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1]
    halign: "left"
    valign: "top"

<ChannelTitle@WrappedLabel>:
    font_size: sp(20)
    bold: True
    color: TEXT
    padding: dp(16), dp(4), dp(16), dp(8)

<RoundButton@ButtonBehavior+Label>:
    bold: True
    font_size: sp(15)
    color: TEXT
    canvas.before:
        Color:
            rgba: ACCENT[:3] + [0.7 if self.state == "down" else 1]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

# Une vidéo : miniature pleine largeur, puis titre, date et vues, description.
<VideoCard>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: 0, 0, 0, dp(16)
    canvas.before:
        Color:
            rgba: SURFACE if self.state == "down" else BG
        Rectangle:
            pos: self.pos
            size: self.size

    AsyncImage:
        source: root.thumbnail
        size_hint_y: None
        height: self.width * 9 / 16
        # Recadre la miniature 4:3 de YouTube en 16:9, sans bandes noires.
        fit_mode: "cover"
        canvas.before:
            Color:
                rgba: SURFACE
            Rectangle:
                pos: self.pos
                size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16), dp(12), dp(16), 0
        spacing: dp(4)

        WrappedLabel:
            text: root.title
            font_size: sp(16)
            bold: True
            color: TEXT
            max_lines: 2

        WrappedLabel:
            text: root.meta
            font_size: sp(13)
            color: MUTED

        WrappedLabel:
            text: root.description
            font_size: sp(13)
            color: MUTED
            max_lines: 4

BoxLayout:
    orientation: "vertical"

    # En-tête : nom de l'application et recherche
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16), dp(12)
        spacing: dp(12)

        WrappedLabel:
            text: "Free[color=f04438]Tube[/color]"
            markup: True
            font_size: sp(22)
            bold: True
            color: TEXT

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            # Fond arrondi dessiné par le parent : le curseur et le texte du champ restent visibles.
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: SURFACE
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [self.height / 2]

                TextInput:
                    id: query
                    hint_text: "@chaîne, adresse ou ID YouTube"
                    multiline: False
                    write_tab: False
                    font_size: sp(15)
                    padding: dp(18), (self.height - self.line_height) / 2
                    background_normal: ""
                    background_active: ""
                    background_color: 0, 0, 0, 0
                    foreground_color: TEXT
                    hint_text_color: MUTED
                    cursor_color: ACCENT
                    on_text_validate: app.load(self.text)

            RoundButton:
                text: "OK"
                size_hint_x: None
                width: dp(64)
                on_release:
                    query.focus = False
                    app.load(query.text)

    # Chargement ou message d'erreur
    WrappedLabel:
        text: app.status
        color: MUTED
        font_size: sp(14)
        halign: "center"
        padding: dp(24), dp(12)
        height: self.texture_size[1] if self.text else 0

    ScrollView:
        id: scroll
        do_scroll_x: False
        bar_width: dp(4)

        BoxLayout:
            id: videos
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            padding: 0, 0, 0, dp(24)
